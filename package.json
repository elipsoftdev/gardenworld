{
  "name": "gardenworld",
  "version": "1.0.0",
  "private": true,
  "description": "Garden World — bases para mangueras y diseño para exterior",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
