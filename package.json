    "test": "npm run test:unit && npm run test:api"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
