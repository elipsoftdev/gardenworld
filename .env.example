# Environment flavour: "development" keeps the site noindex and enables dev-only seeds.
SITE_ENV=development
SITE_URL=http://localhost:3100

# SQLite database file. Created (with its parent directory) on first boot.
# DEV on Render uses ephemeral storage: /tmp/gardenworld-dev.db
# Production will later point at a persistent disk: /var/data/gardenworld.db
DATABASE_PATH=./data/gardenworld-dev.db

# Directory where uploaded images are stored and served from under /media/...
# DEV on Render: /tmp/gardenworld-uploads
# Production later: /var/data/uploads
UPLOAD_DIR=./data/uploads

# First-run accounts. They are created only when no user holds that role yet,
# an existing password is never overwritten, and values are never logged.
BOOTSTRAP_SUPERADMIN_NAME=Elipsoft
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: inserts unpublished demo categories/products. Only honoured when
# SITE_ENV=development. Never enable it in production.
ENABLE_DEV_SEED=false

NEXT_TELEMETRY_DISABLED=1
